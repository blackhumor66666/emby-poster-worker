# =============================================================================
# Emby Poster Worker — 环境变量模板
# 复制为 .env 后按自己的环境修改：cp .env.example .env
# 不要把填好的 .env 提交到仓库。
# =============================================================================

# ---------------------------------------------------------------- 必填
# Emby 服务地址（Worker 容器能访问到的地址）
EMBY_URL=http://your-emby-host:8096
# Emby → 设置 → 高级 → API 密钥，需要有读取媒体和修改图片的权限
EMBY_API_KEY=
# Worker 自己的对外地址，必须是 Emby 容器能访问到的地址（含实际映射端口）。
# Emby 会把这个 URL 代理给所有客户端，填错会导致海报空白。
PUBLIC_BASE_URL=http://your-worker-host:8098
# Worker 容器内监听端口，通常不用改；宿主机映射端口见 PUBLIC_PORT
HTTP_PORT=8080
PUBLIC_PORT=8098

# ---------------------------------------------------------------- 试运行
# true = 完整走「读取 → 评分 → 渲染」，但绝不写回 Emby 图片，也不保存条目状态。
# 渲染结果留在 cache/rendered/ 里可以直接打开看。第一次部署强烈建议先开这个，
# 确认效果后再改回 false。改回后的一次真实扫描会重新处理全库，不会漏条目。
DRY_RUN=false
# 忽略状态签名强制重绘一遍（一般不需要；排查渲染问题时可临时打开）
FORCE_RENDER=false

# ---------------------------------------------------------------- 评分源
OMDB_API_KEY=
OMDB_API_KEYS=
MDBLIST_API_KEYS=
# 单 key 兼容写法，等价于 MDBLIST_API_KEYS 填一个
MDBLIST_API_KEY=
MDBLIST_API_BASE=https://api.mdblist.com
MDBLIST_USE_PROXY=false
MDBLIST_CACHE_DAYS=7
MDBLIST_ERROR_CACHE_MINUTES=60
MDBLIST_MIN_INTERVAL_MS=250
MDBLIST_RETRY_COUNT=2
MDBLIST_BACKOFF_SECONDS=2
RATING_EXTERNAL_PROVIDER_ORDER=mdblist,omdb

# ---------------------------------------------------------------- 豆瓣
# 指向神医助手 Pro 的 metadata_root 目录（内含 cache/ 子目录）。
# 在 compose 里通过 DOUBAN_CACHE_HOST_PATH 挂载到宿主机，容器内路径保持默认。
DOUBAN_CACHE_DIR=/data/douban
# true = 只采信经身份校验的本地缓存，缺失时豆瓣列显示 --，不拿 CommunityRating 顶替
DOUBAN_REQUIRE_VERIFIED_CACHE=true
DOUBAN_CACHE_STALE_DAYS=90
# 上游刷新期间评分短暂消失时，连续确认几次才清除旧分
DOUBAN_MISSING_CONFIRMATIONS=3
# 是否把 Emby 的 CommunityRating 当作豆瓣分（仅在 DOUBAN_REQUIRE_VERIFIED_CACHE=false 时生效）
COMMUNITY_RATING_IS_DOUBAN=false
COMMUNITY_RATING_REQUIRES_DOUBAN_ID=true
# 是否把 CriticRating 当作烂番茄影评人分
CRITIC_RATING_IS_RT=true
RATING_DISPLAY_STRATEGY=compact
REQUIRE_ALL_RATINGS=false
TWO_SOURCE_SECOND_LEFT_RATIO=0.53

# ---------------------------------------------------------------- 评分刷新周期
RATING_REFRESH_DAYS=3
DOUBAN_REFRESH_DAYS=3
IMDB_REFRESH_DAYS=7
RT_REFRESH_DAYS=7
SERIES_MEDIA_CACHE_DAYS=7
SERIES_MEDIA_SOURCE_LIMIT=12

# ---------------------------------------------------------------- 海报输出
POSTER_OUTPUT_WIDTH=1000
POSTER_OUTPUT_HEIGHT=1500
# url = 让 Emby 引用 Worker 的图片地址（不写 115 只读盘）
# upload = 直接上传图片到 Emby；dual = 两者都做
IMAGE_DELIVERY_MODE=url

# ---------------------------------------------------------------- 处理范围
# 留空 = 处理所有 Movie/Series/Season；填 Emby 库 ID（逗号分隔）则只处理这些库
LIBRARY_IDS=
# 只处理指定条目 ID（逗号分隔），首次验证建议填一部片
ITEM_IDS=
# 定时扫描间隔（秒）
POLL_SECONDS=3600
SCAN_PROGRESS_EVERY=50

# ---------------------------------------------------------------- 存储路径
CACHE_DIR=/data/cache
ADMIN_DATA_DIR=/data/config
RATING_OVERRIDES_FILE=/data/cache/rating-overrides.json
SCAN_REPORT_FILE=/data/cache/reports/last-scan.json
REVIEW_REPORT_FILE=/data/cache/reports/review-needed.json
MEDIA_HEALTH_REPORT_FILE=/data/cache/reports/media-health.json
RENDER_QUEUE_FILE=/data/cache/render-queue.json
BOXSET_COVERS_STATE_FILE=/data/cache/state/boxset-covers.json
# 孤儿缓存只报告不删除，确认为 true 才真正清理
CACHE_GC_ENABLED=false
CACHE_GC_DAYS=30

# ---------------------------------------------------------------- 原图备份
# 原图是唯一无法重建的数据（Emby 里存的是渲染后的图），建议开启。
# 开启后按 BACKUP_INTERVAL_DAYS 把 cache/original/ 打包到 BACKUP_DIR（另一个卷）。
BACKUP_ENABLED=false
BACKUP_DIR=
BACKUP_KEEP=2
BACKUP_HOUR=3
BACKUP_INTERVAL_DAYS=7

# ---------------------------------------------------------------- Emby Webhook 即时渲染
# 留空 = 不启用。设置后可用 Emby 的 Webhook 插件在入库时立刻渲染单片：
#   POST /webhook/emby?token=<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=
WEBHOOK_MAX_QUEUE=10
WEBHOOK_MIN_INTERVAL_SECONDS=30

# ---------------------------------------------------------------- 失败告警
# 扫描失败条目数达到 ALERT_MIN_FAILED 时 POST 到该地址（支持企业微信/钉钉机器人等）
ALERT_WEBHOOK_URL=
ALERT_MIN_FAILED=1

# ---------------------------------------------------------------- 合集封面
# Emby 建合集时不会下载封面，扫描开头补一次图片刷新
BOXSET_COVERS_ENABLED=true
# TMDB 确实没有合集海报的条目，隔多少天再试一次（期间复用成员影片封面）
BOXSET_COVERS_RETRY_DAYS=7
# 可选：季海报只显示每季独立评分，不继承剧集级 IMDb/RT
SEASON_POSTERS_ENABLED=false

# ---------------------------------------------------------------- 管理控制台
# 留空 ADMIN_PASSWORD 时，首次启动会随机生成初始密码并只打印在容器日志里：
#   docker logs emby-poster-worker | grep -i "bootstrap"
# 首次登录后必须修改密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_TTL=86400

# ---------------------------------------------------------------- 网络与超时
# 能直连时保持为空；需要代理时把 Emby 地址加进 NO_PROXY 避免内网流量绕路
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
EMBY_REQUEST_TIMEOUT=30
ADMIN_API_TIMEOUT=12
EMBY_PAGE_SIZE=200
OMDB_CACHE_DAYS=3
OMDB_ERROR_CACHE_MINUTES=60
OMDB_MIN_INTERVAL_MS=250
OMDB_RETRY_COUNT=2
OMDB_BACKOFF_SECONDS=2
OMDB_CIRCUIT_BREAK_MINUTES=15
OMDB_SKIP_GENRES=Concert,Music,Live,综艺,演唱会

# ---------------------------------------------------------------- 日志
LOG_TIMEZONE=Asia/Shanghai
LOG_HTTP_REQUESTS=false
LOG_ITEM_UPDATES=true

# ---------------------------------------------------------------- 版本
# 改代码或行为时递增 APP_VERSION；改海报绘制规则时才递增 RENDER_VERSION
# （RENDER_VERSION 参与每条目的签名，改动会触发全库重绘）
APP_VERSION=1.0.0
RENDER_VERSION=2.5

# ---------------------------------------------------------------- compose 挂载（宿主机侧）
# NAS 部署时改成自己的绝对路径；不要写进仓库
CACHE_HOST_PATH=./cache
CONFIG_HOST_PATH=./config
# 留空则使用仓库自带的空 douban-cache/，豆瓣列会显示 --
DOUBAN_CACHE_HOST_PATH=
